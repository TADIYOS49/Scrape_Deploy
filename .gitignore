# ============================================================================
# DEVELOPMENT & TESTING FILES
# ============================================================================
# Test files
test_*.py
*_test.py
tests/
testing/

# Local development files
local_*.py
debug_*.py
scratch.py
temp.py

# Sample data (keep templates, exclude actual data)
sample_*.csv
local_*.csv

# ============================================================================
# DOCKER & DEPLOYMENT FILES (Optional)
# ============================================================================
# Docker volumes and build cache
.dockerignore.local

# Kubernetes configs with secrets
k8s-secrets.yaml
*-secret.yaml

# ============================================================================
# CLOUD SPECIFIC FILES
# ============================================================================
# Google Cloud
.gcloudignore

# AWS
.aws/

# Azure
.azure/

# ============================================================================
# BROWSER AUTOMATION FILES
# ============================================================================
# Playwright downloads
playwright/
.playwright/

# Screenshots and videos from debugging
screenshots/
videos/
downloads/

# ============================================================================
# MISCELLANEOUS
# ============================================================================
# Temporary files
tmp/
temp/
*.tmp
*.temp

# Archive files
*.zip
*.tar.gz
*.rar

# Database files (if any)
*.db
*.sqlite
*.sqlite3

# Node modules (if any frontend)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================================================
# PROJECT SPECIFIC EXCLUSIONS
# ============================================================================
# Large CSV files (except the main input file)
# Keep seminole_property_urls.csv but exclude results
# seminole_property_urls.csv  # Uncomment if you want to exclude input CSV too

# Session files
session_*.json
browserbase_session.json 