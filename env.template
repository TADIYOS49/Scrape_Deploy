# Browserbase Property Scraper - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================================================
# BROWSERBASE CONFIGURATION (REQUIRED)
# ============================================================================
# Get these from https://www.browserbase.com dashboard
BROWSERBASE_API_KEY=your_browserbase_api_key_here
BROWSERBASE_PROJECT_ID=your_browserbase_project_id_here

# ============================================================================
# GOOGLE CLOUD CONFIGURATION (FOR CLOUD DEPLOYMENT ONLY)
# ============================================================================
# Google Cloud Storage bucket for storing results
GCS_BUCKET_NAME=your-scraper-results-bucket

# Google Cloud Project ID (for Cloud Run deployment)
GCP_PROJECT_ID=your-gcp-project-id

# ============================================================================
# OPTIONAL CONFIGURATION
# ============================================================================
# Port for local development (default: 5000 for swagger_api.py, 8080 for main.py)
PORT=5000

# CSV file path (default: seminole_property_urls.csv)
CSV_PATH=seminole_property_urls.csv

# Output file name (default: final_results_Seminole.csv)
OUTPUT_FILE=final_results_Seminole.csv

# Processing chunk size (default: 100)
CHUNK_SIZE=100

# Progress tracking file (default: progress.txt)
PROGRESS_FILE=progress.txt

# ============================================================================
# USAGE INSTRUCTIONS
# ============================================================================
# 1. Copy this file: cp env.template .env
# 2. Edit .env with your actual values
# 3. For local development: source .env (or the app will load it automatically)
# 4. For Cloud Run: Set environment variables in deploy.sh or gcloud command 